# Obtain bot token from @BotFather. Do not commit actual secrets.
BOT_TOKEN=
MINI_APP_URL=https://YOUR-DOMAIN.example
# For local development (sqlite). Set DATABASE_URL=postgresql+psycopg2://... for production.
DATABASE_URL=sqlite:///./english_quest.db
OWNER_TELEGRAM_ID=0
PREMIUM_STARS=149
# NEVER enable on a public deployment.
DEMO_MODE=false
